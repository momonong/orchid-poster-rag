# Copy to deploy/.env; values are target Ubuntu paths, resolved before Compose starts.
ORCHID_IMAGE=orchid-poster:ubuntu-20261102
ORCHID_RUNTIME_DIR=/srv/orchid/runtime
ORCHID_RECORDS_DIR=/srv/orchid/records
ORCHID_SPEECH_CACHE_DIR=/srv/orchid/speech-cache
SELFHOST_MODEL_KEY_FILE=/srv/selfhost-models/.state/api-key
ORCHID_UID=1000
ORCHID_GID=1000
ORCHID_PORT=8000
ORCHID_ROOT_PATH=/orchid-poster
ORCHID_PUBLIC_URL=https://cball.computing.ncku.edu.tw/orchid-poster/
SELFHOST_MODEL_BASE_URL=http://127.0.0.1:18080
SELFHOST_MODEL_EXPECTED_ID=Qwen/Qwen3.5-4B
SELFHOST_MODEL_CONTEXT_TOKENS=8192
# Optional: enable only when also using -f deploy/compose.review.yaml (never put the key value here).
# ORCHID_REVIEW_KEY_FILE=/srv/orchid/private/review.key
